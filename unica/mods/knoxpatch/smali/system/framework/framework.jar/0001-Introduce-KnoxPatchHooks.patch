+    .locals 1
     .annotation runtime Landroid/annotation/SystemApi;
     .end annotation
 
+    invoke-static {p0}, Lio/mesalabs/unica/KnoxPatchHooks;->onSystemPropertiesGet(Ljava/lang/String;)Ljava/lang/String;
