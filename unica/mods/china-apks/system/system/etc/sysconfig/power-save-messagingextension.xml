<?xml version="1.0" encoding="UTF-8"?>
<config>
    <!-- These are the standard packages that are white-listed to always have internet access while in power save mode, even if they aren't in the foreground. -->
    <!-- MessagingExtension must always have network access for SamsungMessage to provider Smart sms function -->
    <allow-in-power-save package="com.samsung.android.messaging.extension.chn" />
    <allow-in-power-save-except-idle package="com.samsung.android.messaging.extension.chn" />
</config>