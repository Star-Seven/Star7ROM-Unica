<!--
  ~ This XML file declares which platform signature permissions to grant to
  ~ platform signed nonsystem apps.
-->
<permissions>
    <signature-permissions package="com.samsung.android.messaging.extension.chn">
        <permission name="com.samsung.android.messaging.extension.chn.permission.READ_MESSAGE"/>
        <permission name="com.samsung.android.messaging.extension.chn.permission.WRITE_MESSAGE"/>
		<permission name="android.permission.QUERY_ALL_PACKAGES"/>
    </signature-permissions>
</permissions>
