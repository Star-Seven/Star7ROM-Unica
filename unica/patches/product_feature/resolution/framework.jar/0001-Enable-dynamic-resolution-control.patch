From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Star-Seven <72426083+Star-Seven@users.noreply.github.com>
Date: Sun, 28 Sep 2026 05:00:00 +0000
Subject: [PATCH] Enable dynamic resolution control

Only FW_DYNAMIC_RESOLUTION_CONTROL is flipped. FW_SUPPORT_MULTI_RESOLUTION
and FW_MULTI_RESOLUTION_POLICY must stay false on a QHD target: enabling them
activates the One UI 8.5 WMS baseScreenRatio path, which forces the logical
display to 1080x2280@420 on the Note10+ 1440x3040 panel.
---
 smali_classes6/com/samsung/android/rune/CoreRune.smali | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/smali_classes6/com/samsung/android/rune/CoreRune.smali b/smali_classes6/com/samsung/android/rune/CoreRune.smali
index eb31080..2b64b5a 100644
--- a/smali_classes6/com/samsung/android/rune/CoreRune.smali
+++ b/smali_classes6/com/samsung/android/rune/CoreRune.smali
@@ -2786,7 +2786,7 @@
 
     sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_MULTI_RESOLUTION_POLICY:Z
 
-    sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_DYNAMIC_RESOLUTION_CONTROL:Z
+    sput-boolean v3, Lcom/samsung/android/rune/CoreRune;->FW_DYNAMIC_RESOLUTION_CONTROL:Z
 
     const-string v0, "2"
 
--
2.45.2
